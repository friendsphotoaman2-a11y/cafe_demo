# Cafe Manager Allowlist (comma-separated emails)
MANAGER_EMAILS=

# Google Sheets Real-time Sync & Archival
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
