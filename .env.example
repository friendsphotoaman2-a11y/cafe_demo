CAFE_DEMO_ASSET_PREFIX=/cafe-static
NEXT_PUBLIC_BASE_PATH=/demo/cafe
NEXT_PUBLIC_ASSET_PREFIX=/cafe-static
NEXT_PUBLIC_ORDERING_BASE_URL=https://www.thebusinesswork.com/demo/cafe
NEXT_PUBLIC_APP_URL=https://www.thebusinesswork.com/demo/cafe

# Supabase Public Credentials (Safe for client)
